# Dependencies
node_modules/
vendor/
# The docs self-host any third-party asset here (none today).
!docs/assets/vendor/

# Build outputs
dist/
bin/
out/
# go build ./hack/release-gate (and the other hack programs) at the root
/release-gate
/hygiene
# Exception: web/dist is committed for go:embed to work during Go builds
!web/dist/
!web/dist/**

# Research (local only — not committed)
research/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Environment
.env
.env.*
!.env.example

# Go
*.test
*.out
coverage.txt

# Compiled binaries in the repo root. Anchored with a leading / so they do not
# also match the cmd/kardinal*/ source directories.
/kardinal-controller
/kardinal

# Worktree artifacts that must not land in main repo root
CLAIM
ITEM.md

# Misc
*.log
.claude/agents/


# Live e2e state: env file, generated credentials, failure diagnostics
/test/e2e/results/
test-results/

# Python bytecode (hack/docs-station-map is a MkDocs hook)
__pycache__/
*.pyc

# The docs site mkdocs builds (docs.yml deploys it); never committed (make hygiene).
/site/
