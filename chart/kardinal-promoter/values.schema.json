{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "kardinal-promoter chart values",
  "description": "Unknown keys are rejected so a misspelled or removed value fails instead of being ignored.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "shutdownDelaySeconds": {
      "type": "integer",
      "minimum": 0
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "tag": {
          "type": [
            "string",
            "number"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "podAnnotations": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "logLevel": {
      "type": "string",
      "enum": [
        "debug",
        "info",
        "warn",
        "error"
      ]
    },
    "leaderElect": {
      "type": "boolean"
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accessLog": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allRequests": {"type": "boolean"},
            "sourceIP": {"type": "boolean"},
            "trustedProxies": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": "^[0-9a-fA-F.:/]+$"}}
          }
        },
        "tlsCertFile": {
          "type": "string"
        },
        "tlsKeyFile": {
          "type": "string"
        },
        "watchNamespace": {
          "type": "string"
        },
        "namespaceShard": {
          "type": "string",
          "pattern": "^$|^[A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?$"
        },
        "policyNamespaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gateStatusHeartbeat": {
          "type": "string",
          "pattern": "^$|^(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
        },
        "workers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "promotionStep": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "prStatus": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "policyGate": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "bundle": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "pipeline": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            }
          }
        },
        "gateOverrideMaxMinutes": {
          "type": ["string", "integer"],
          "pattern": "^$|^[1-9][0-9]*$",
          "minimum": 1,
          "description": "--gate-override-max-minutes: the override cap in minutes; empty keeps 1440."
        },
        "extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extraEnv": {
          "type": "array"
        },
        "extraVolumes": {
          "type": "array"
        },
        "extraVolumeMounts": {
          "type": "array"
        }
      }
    },
    "metricsBindAddress": {
      "type": "string"
    },
    "healthProbeBindAddress": {
      "type": "string"
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metricsPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "healthPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "uiPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "webhookPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "token": {
          "type": "string"
        },
        "secretRef": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "namespace": {
              "type": "string"
            },
            "key": {
              "type": "string"
            }
          }
        },
        "app": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "The github.secretRef Secret holds githubAppID, githubAppInstallationID and githubAppPrivateKey instead of a token."
            }
          }
        }
      }
    },
    "scm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "description": "--scm-provider; the controller rejects unknown providers at startup."
        },
        "apiURL": {
          "type": "string"
        },
        "allowedRepositories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "--scm-allowed-repositories: host/repository globs the controller's SCM token may act on."
        },
        "instanceSigners": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "--scm-instance-signers: names or emails the Forgejo/Gitea instance signs commits with."
        },
        "gatesCommitStatus": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "--gates-commit-status: post the gate results as a commit status on pr-review PRs."
            },
            "context": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "^[^\\s,]+$",
              "description": "--gates-status-context: the reserved commit status name branch protection requires."
            }
          }
        }
      }
    },
    "webhook": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "secretRef": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "default": "secret"
            }
          }
        }
      }
    },
    "bundleAPI": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tokenSecretRef": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "default": "token"
            }
          }
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "corsAllowedOrigins": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowedHosts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^/*@,\\s]+$"
          }
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tokenSecretRef": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "key": {
                  "type": "string",
                  "default": "token"
                }
              }
            },
            "tokenReview": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "argocdApplicationsWrite": {
          "type": "boolean"
        },
        "integrationTestJobs": {
          "type": "boolean",
          "description": "Deprecated, no effect, removed in v0.10."
        }
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "serviceAccountName": {
          "type": "string",
          "minLength": 1
        },
        "kroNamespace": {
          "type": "string"
        },
        "aggregateToKro": {
          "type": "boolean"
        },
        "compactAbove": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "readerNamespaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "retire": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "superseded": {
              "type": "string",
              "pattern": "^$|^(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
            },
            "failed": {
              "type": "string",
              "pattern": "^$|^(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
            },
            "verified": {
              "type": "string",
              "pattern": "^$|^(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
            }
          }
        }
      }
    },
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "description": "Pipeline pre- and post-deploy hooks (docs/hooks.md).",
      "properties": {
        "serviceAccounts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
          },
          "minItems": 1,
          "description": "ServiceAccount names a hook's Job Pod may run as (--hook-service-accounts)."
        },
        "podSecurityLevel": {
          "type": "string",
          "enum": ["baseline", "restricted", "privileged"],
          "description": "Pod Security Standard a hook's Pod must meet (--hook-pod-security-level)."
        }
      }
    },
    "validatingAdmissionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "description": "Deprecated, no effect."
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "controllerUsernames": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "pattern": "^[^*]+$"},
          "description": "Exact usernames, besides this release's controller ServiceAccount, that run a kardinal controller."
        }
      }
    },
    "tracing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "endpoint": {"type": "string", "pattern": "^$|^https?://[^\\s/]+(/\\S*)?$|^[^\\s/:]+:[0-9]{1,5}$"},
        "insecure": {"type": "boolean"},
        "samplingRatio": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "egress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowlist": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(\\*\\.)?[A-Za-z0-9_.:\\[\\]-]+(/[0-9]{1,3})?$"
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressFrom": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "metrics": {
              "type": "array"
            },
            "health": {
              "type": "array"
            },
            "ui": {
              "type": "array"
            },
            "webhook": {
              "type": "array"
            }
          }
        },
        "extraEgress": {
          "type": "array"
        }
      }
    },
    "metricCheck": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cloudWatch": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ambientCredentials": {
              "type": "boolean"
            }
          }
        },
        "querySlots": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "global": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "perNamespace": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          }
        }
      }
    },
    "scheduleClock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "interval": {
          "type": "string"
        }
      }
    },
    "pdb": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": [
            "integer",
            "string"
          ]
        }
      }
    },
    "topologySpread": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "demo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "string"
        },
        "secretRef": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            }
          }
        },
        "git": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "prometheusRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "additionalLabels": {
          "type": "object"
        },
        "namespace": {
          "type": "string"
        }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "interval": {
          "type": "string",
          "pattern": "^$|^(0|(([0-9]+)y)?(([0-9]+)w)?(([0-9]+)d)?(([0-9]+)h)?(([0-9]+)m)?(([0-9]+)s)?(([0-9]+)ms)?)$"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "grafanaDashboard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "sidecarLabel": {
          "type": "object"
        },
        "namespace": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      }
    }
  }
}
