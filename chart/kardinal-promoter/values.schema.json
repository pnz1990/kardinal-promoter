{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "kardinal-promoter chart values",
  "description": "Unknown keys are rejected so a misspelled or removed value fails instead of being ignored.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "shutdownDelaySeconds": {
      "type": "integer",
      "minimum": 0
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "tag": {
          "type": [
            "string",
            "number"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "podAnnotations": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "logLevel": {
      "type": "string",
      "enum": [
        "debug",
        "info",
        "warn",
        "error"
      ]
    },
    "leaderElect": {
      "type": "boolean"
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tlsCertFile": {
          "type": "string"
        },
        "tlsKeyFile": {
          "type": "string"
        },
        "watchNamespace": {
          "type": "string"
        },
        "policyNamespaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gateStatusHeartbeat": {
          "type": "string",
          "pattern": "^$|^(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
        },
        "extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extraEnv": {
          "type": "array"
        },
        "extraVolumes": {
          "type": "array"
        },
        "extraVolumeMounts": {
          "type": "array"
        }
      }
    },
    "metricsBindAddress": {
      "type": "string"
    },
    "healthProbeBindAddress": {
      "type": "string"
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metricsPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "healthPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "uiPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "webhookPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "token": {
          "type": "string"
        },
        "secretRef": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "namespace": {
              "type": "string"
            },
            "key": {
              "type": "string"
            }
          }
        },
        "app": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "The github.secretRef Secret holds githubAppID, githubAppInstallationID and githubAppPrivateKey instead of a token."
            }
          }
        }
      }
    },
    "scm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "description": "--scm-provider; the controller rejects unknown providers at startup."
        },
        "apiURL": {
          "type": "string"
        },
        "allowedRepositories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "--scm-allowed-repositories: host/repository globs the controller's SCM token may act on."
        }
      }
    },
    "webhook": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "secretRef": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "default": "secret"
            }
          }
        }
      }
    },
    "bundleAPI": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tokenSecretRef": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "default": "token"
            }
          }
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "corsAllowedOrigins": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowedHosts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^/*@,\\s]+$"
          }
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tokenSecretRef": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "key": {
                  "type": "string",
                  "default": "token"
                }
              }
            },
            "tokenReview": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "argocdApplicationsWrite": {
          "type": "boolean"
        },
        "integrationTestJobs": {
          "type": "boolean",
          "description": "Deprecated, no effect, removed in v0.10."
        }
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "serviceAccountName": {
          "type": "string"
        },
        "kroNamespace": {
          "type": "string"
        },
        "aggregateToKro": {
          "type": "boolean"
        },
        "readerNamespaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "validatingAdmissionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "description": "Deprecated, no effect."
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressFrom": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "metrics": {
              "type": "array"
            },
            "health": {
              "type": "array"
            },
            "ui": {
              "type": "array"
            },
            "webhook": {
              "type": "array"
            }
          }
        },
        "extraEgress": {
          "type": "array"
        }
      }
    },
    "scheduleClock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "interval": {
          "type": "string"
        }
      }
    },
    "pdb": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": [
            "integer",
            "string"
          ]
        }
      }
    },
    "topologySpread": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "demo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "string"
        },
        "secretRef": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            }
          }
        },
        "git": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "prometheusRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "additionalLabels": {
          "type": "object"
        },
        "namespace": {
          "type": "string"
        }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "interval": {
          "type": "string",
          "pattern": "^$|^(0|(([0-9]+)y)?(([0-9]+)w)?(([0-9]+)d)?(([0-9]+)h)?(([0-9]+)m)?(([0-9]+)s)?(([0-9]+)ms)?)$"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "grafanaDashboard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "sidecarLabel": {
          "type": "object"
        },
        "namespace": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      }
    }
  }
}
