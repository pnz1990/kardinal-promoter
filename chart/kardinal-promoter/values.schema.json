{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "ui": {
      "type": "object",
      "properties": {
        "allowedHosts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^/*@,\\s]+$"
          }
        }
      }
    }
  }
}
