{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "kardinal-promoter chart values",
  "description": "Unknown keys are rejected so a misspelled or unknown value fails instead of being ignored.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "shutdownDelaySeconds": {
      "type": "integer",
      "minimum": 0
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "tag": {
          "type": [
            "string",
            "number"
          ]
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "podAnnotations": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "logLevel": {
      "type": "string",
      "enum": [
        "debug",
        "info",
        "warn",
        "error"
      ]
    },
    "leaderElect": {
      "type": "boolean"
    },
    "leaderElectionFlowSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "matchingPrecedence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "priorityLevel": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accessLog": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allRequests": {"type": "boolean"},
            "sourceIP": {"type": "boolean"},
            "trustedProxies": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": "^[0-9a-fA-F.:/]+$"}},
            "auditEvents": {"type": "boolean"}
          }
        },
        "tlsCertFile": {
          "type": "string"
        },
        "tlsKeyFile": {
          "type": "string"
        },
        "watchNamespace": {
          "type": "string"
        },
        "namespaceShard": {
          "type": "string",
          "pattern": "^$|^[A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?$"
        },
        "policyNamespaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gateStatusHeartbeat": {
          "type": "string",
          "pattern": "^$|^(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
        },
        "workers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "promotionStep": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "prStatus": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "policyGate": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "bundle": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "pipeline": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            }
          }
        },
        "gateOverrideMaxMinutes": {
          "type": ["string", "integer"],
          "pattern": "^$|^[1-9][0-9]*$",
          "minimum": 1,
          "description": "--gate-override-max-minutes: the override cap in minutes; empty keeps 1440."
        },
        "freezeExemptionMaxMinutes": {
          "type": ["string", "integer"],
          "pattern": "^$|^[1-9][0-9]*$",
          "minimum": 1,
          "description": "--freeze-exemption-max-minutes: the freeze exemption cap in minutes; empty keeps 1440."
        },
        "extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extraEnv": {
          "type": "array"
        },
        "extraVolumes": {
          "type": "array"
        },
        "extraVolumeMounts": {
          "type": "array"
        }
      }
    },
    "metricsBindAddress": {
      "type": "string"
    },
    "healthProbeBindAddress": {
      "type": "string"
    },
    "pprofAddress": {
      "type": "string"
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metricsPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "healthPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "uiPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "webhookPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "token": {
          "type": "string"
        },
        "secretRef": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "namespace": {
              "type": "string"
            },
            "key": {
              "type": "string"
            }
          }
        },
        "app": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "The github.secretRef Secret holds githubAppID, githubAppInstallationID and githubAppPrivateKey instead of a token."
            }
          }
        }
      }
    },
    "scm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "description": "--scm-provider; the controller rejects unknown providers at startup."
        },
        "apiURL": {
          "type": "string"
        },
        "token": {
          "type": "string",
          "description": "SCM token; the chart stores it in a Secret. github.token is the old name."
        },
        "secretRef": {
          "type": "object",
          "additionalProperties": false,
          "description": "Existing Secret with the SCM token. github.secretRef is the old name.",
          "properties": {
            "name": {
              "type": "string"
            },
            "namespace": {
              "type": "string"
            },
            "key": {
              "type": "string"
            }
          }
        },
        "allowedRepositories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "--scm-allowed-repositories: host/repository globs the controller's SCM token may act on."
        },
        "providersAllowInsecureHTTP": {
          "type": "boolean",
          "description": "--scm-providers-allow-http: let ScmProviders use an http:// spec.apiURL."
        },
        "instanceSigners": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "--scm-instance-signers: names or emails the Forgejo/Gitea instance signs commits with."
        },
        "gatesCommitStatus": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "--gates-commit-status: post the gate results as a commit status on pr-review PRs."
            },
            "context": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "^[^\\s,]+$",
              "description": "--gates-status-context: the reserved commit status name branch protection requires."
            }
          }
        }
      }
    },
    "webhook": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "secretRef": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "default": "secret"
            }
          }
        }
      }
    },
    "bundleAPI": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tokenSecretRef": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "default": "token"
            }
          }
        },
        "tokenReview": {
          "type": "boolean"
        },
        "acceptAPIServerAudience": {
          "type": "boolean"
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "corsAllowedOrigins": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowedHosts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^/*@,\\s]+$"
          }
        },
        "basePath": {
          "type": "string",
          "pattern": "^$|^(/[A-Za-z0-9._~-]+)+/?$"
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tokenSecretRef": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "key": {
                  "type": "string",
                  "default": "token"
                }
              }
            },
            "tokenReview": {
              "type": "boolean"
            },
            "allowStaticTokenWithTokenReview": {
              "type": "boolean"
            }
          }
        },
        "freezeControls": {
          "type": "boolean"
        }
      }
    },
    "tokenReview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "audiences": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^,\\s]+$"
          }
        },
        "acceptAPIServerAudience": {
          "type": "boolean"
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "refresh": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "--health-refresh: ask Argo CD or Flux to sync a promotion's commit at once, and grant patch on Applications, Kustomizations and GitRepositories."
            },
            "namespaces": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(\\*|[a-z0-9]([-a-z0-9]*[a-z0-9])?|[a-z0-9][-a-z0-9]*\\*)=(\\*|[a-z0-9]([-a-z0-9]*[a-z0-9])?|[a-z0-9][-a-z0-9]*\\*)$"
              },
              "description": "--health-refresh-namespaces: pipelineNamespace=namespace rules for the GitOps objects a Pipeline may have the controller refresh, besides its own namespace's."
            }
          }
        }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "argocdApplicationsWrite": {
          "type": "boolean"
        },
        "userRoles": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "aggregateToDefaultRoles": {"type": "boolean"},
            "directWrites": {"type": "boolean"}
          }
        }
      }
    },
    "fleets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "applicationNamespaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
          }
        },
        "clusterProfileNamespaces": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
          }
        }
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "serviceAccountName": {
          "type": "string",
          "minLength": 1
        },
        "kroNamespace": {
          "type": "string"
        },
        "aggregateToKro": {
          "type": "boolean"
        },
        "compactAbove": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "readerNamespaces": {
          "description": "Removed (#1283): setting it fails the install.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "retire": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "superseded": {
              "type": "string",
              "pattern": "^$|^(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
            },
            "failed": {
              "type": "string",
              "pattern": "^$|^(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
            },
            "verified": {
              "type": "string",
              "pattern": "^$|^(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
            }
          }
        }
      }
    },
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "description": "Pipeline pre- and post-deploy hooks (docs/hooks.md).",
      "properties": {
        "serviceAccounts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
          },
          "minItems": 1,
          "description": "ServiceAccount names a hook's Job Pod may run as (--hook-service-accounts)."
        },
        "podSecurityLevel": {
          "type": "string",
          "enum": ["baseline", "restricted", "privileged"],
          "description": "Pod Security Standard a hook's Pod must meet (--hook-pod-security-level)."
        }
      }
    },
    "actors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "directory": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "public": {"type": "boolean", "description": "Bind the agent directory reader ClusterRole to system:authenticated."}
          }
        }
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "controllerUsernames": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "pattern": "^[^*]+$"},
          "description": "Exact usernames, besides this release's controller ServiceAccount, that run a kardinal controller."
        }
      }
    },
    "tracing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "endpoint": {"type": "string", "pattern": "^$|^https?://[^\\s/]+(/\\S*)?$|^[^\\s/:]+:[0-9]{1,5}$"},
        "insecure": {"type": "boolean"},
        "samplingRatio": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "egress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowlist": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(\\*\\.)?[A-Za-z0-9_.:\\[\\]-]+(/[0-9]{1,3})?$"
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressFrom": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "metrics": {
              "type": "array"
            },
            "health": {
              "type": "array"
            },
            "ui": {
              "type": "array"
            },
            "webhook": {
              "type": "array"
            }
          }
        },
        "extraEgress": {
          "type": "array"
        }
      }
    },
    "changeRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxInflight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "maxInflightPerNamespace": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    },
    "metricCheck": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cloudWatch": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ambientCredentials": {
              "type": "boolean"
            }
          }
        },
        "querySlots": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "global": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "perNamespace": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          }
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "retention": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "AuditEvent retention (on by default) and delete on AuditEvents; false keeps every record."
            },
            "maxAge": {
              "type": "string",
              "pattern": "^(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$",
              "description": "--audit-retention-max-age: delete records created longer ago; 0s keeps any age."
            },
            "maxPerPipeline": {
              "type": "integer",
              "minimum": 0,
              "description": "--audit-retention-max-per-pipeline: newest records kept per Pipeline; 0 keeps any number."
            }
          }
        }
      }
    },
    "receipts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean", "description": "--receipts: create and sign a PromotionReceipt for every promotion that reaches Verified."},
        "clusterID": {"type": "string", "description": "--receipt-cluster-id; empty reads the kube-system Namespace UID."},
        "retention": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxAge": {"type": "string", "pattern": "^((([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)?$",
              "description": "--receipt-retention-max-age; empty keeps every receipt."}
          }
        },
        "signing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {"type": "string", "enum": ["keyless", "key", "kms"]},
            "keyless": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "fulcioURL": {"type": "string", "pattern": "^https?://.+$"},
                "tokenExpirationSeconds": {"type": "integer", "minimum": 600}
              }
            },
            "key": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "secretRef": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {"name": {"type": "string"}, "key": {"type": "string", "minLength": 1}}
                }
              }
            },
            "kmsKey": {"type": "string"},
            "tsaURL": {"type": "string", "pattern": "^(https?://.+)?$"}
          }
        },
        "sinks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "oci": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {"type": "boolean"},
                "secretRef": {"type": "object", "additionalProperties": false, "properties": {"name": {"type": "string"}}},
                "repository": {"type": "string"},
                "allowedRepositories": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": "^[^,\\s]+$"}},
                "insecure": {"type": "boolean"}
              }
            },
            "rekor": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "url": {"type": "string", "pattern": "^(https?://.+)?$"},
                "public": {"type": "boolean", "description": "Allow the public-good Rekor, which publishes each receipt's names, emails and pipeline names."}
              }
            }
          }
        }
      }
    },
    "scheduleClock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "interval": {
          "type": "string"
        }
      }
    },
    "pdb": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": [
            "integer",
            "string"
          ]
        }
      }
    },
    "topologySpread": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "demo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "string"
        },
        "secretRef": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            }
          }
        },
        "git": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "prometheusRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "additionalLabels": {
          "type": "object"
        },
        "namespace": {
          "type": "string"
        }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "interval": {
          "type": "string",
          "pattern": "^$|^(0|(([0-9]+)y)?(([0-9]+)w)?(([0-9]+)d)?(([0-9]+)h)?(([0-9]+)m)?(([0-9]+)s)?(([0-9]+)ms)?)$"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
