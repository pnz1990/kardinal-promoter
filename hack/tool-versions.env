#
# Versions and sha256 sums of the kind, kubectl and helm that
# hack/e2e/tools.sh downloads into bin/e2e, for local live runs and the
# e2e-live workflow. It sources this file and checks every download with
# `sha256sum -c` before running it.
#
# To bump a tool, change its version and its sum together. Take the sum from
# the release's own checksum file, and check it against a hash of the
# downloaded binary:
#   kind:    https://github.com/kubernetes-sigs/kind/releases (kind-linux-amd64.sha256sum)
#   kubectl: https://dl.k8s.io/release/<version>/bin/linux/amd64/kubectl.sha256
#   helm:    https://get.helm.sh/helm-<version>-linux-amd64.tar.gz.sha256sum
#
# KIND_NODE_1_<minor> are the node images of that kind release for the
# Kubernetes minors the live e2e suites run on (the three newest; the oldest is
# the oldest kardinal supports, Chart.yaml kubeVersion), pinned by
# digest as the kind release notes list them. test/e2e/kind-config.yaml uses
# the middle one and KUBECTL_VERSION has its minor, so kubectl's one minor of
# skew covers all three (test/hack checks this).
#

KIND_VERSION=v0.33.0
KIND_SHA256=aee6151561422756b764a4ae28e7f44cda5af5a9eead3cc9985112b1de8d8e0d

KIND_NODE_1_35=kindest/node:v1.35.8@sha256:07b2536e30b803ed61d1677a79df6115f798ce64c80f9e22f6ed45afd09323c0
KIND_NODE_1_36=kindest/node:v1.36.4@sha256:099e049362a1526b2db71494e1947aae99bd16290d7c895f2b7ea312e3cbfaed
KIND_NODE_1_37=kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5

KUBECTL_VERSION=v1.36.5
KUBECTL_SHA256=33bc88a24c3b09cf55bfd59e6ca977881b61fc3f25ab65bc80c65b430248648e

# The release tarball's sum, as ci.yml's chart render tests use.
HELM_VERSION=v3.22.0
HELM_SHA256=1e4ab49e429626cf6c6958d914248b78c9730803c2751b87627e171dc800e7bb

# The promtool the chart's alert tests run (test/helm
# TestChartPrometheusRuleAlertsOnlyOnKardinal, which fails in CI without it):
# hack/ci/install-promtool.sh downloads the Prometheus release tarball, checks
# it with `sha256sum -c` and keeps promtool in bin/e2e. The sum is the
# release's sha256sums.txt line for prometheus-<version>.linux-amd64.tar.gz,
# checked against a hash of the download.
PROMTOOL_VERSION=v3.15.0
PROMTOOL_SHA256=2a542df32eac02ee17b9d844fb2aa1de00dafa5476579ba8a3ba862e9d572ea0

# The shellcheck ci.yml checks the shell scripts with. The release has no
# checksum file: the sum is GitHub's digest of the linux.x86_64.tar.xz asset
# (gh api repos/koalaman/shellcheck/releases/tags/<version>), checked against
# a hash of the download.
SHELLCHECK_VERSION=v0.11.0
SHELLCHECK_SHA256=8c3be12b05d5c177a04c29e3c78ce89ac86f1595681cab149b65b97c4e227198

# The envtest API servers (kube-apiserver and etcd, from controller-tools'
# envtest releases) that `make envtest` and CI's envtest job install every CRD
# and the chart's admission policies on (test/helm/install_envtest_test.go):
# ENVTEST_K8S_MIN is the oldest Kubernetes the chart supports (Chart.yaml
# kubeVersion; test/hack checks they agree), ENVTEST_K8S_MAX the newest
# envtest release. SETUP_ENVTEST_VERSION pins the downloader
# (sigs.k8s.io/controller-runtime/tools/setup-envtest, release-0.23).
ENVTEST_K8S_MIN=1.35.0
ENVTEST_K8S_MAX=1.37.0
SETUP_ENVTEST_VERSION=v0.0.0-20260305142021-f9589b9f2b9d
# trivy for the release gate's image scan (hack/release-gate, make
# release-gate), when it is not on PATH: the Linux 64-bit tarball's sha256
# from the release's trivy_<version>_checksums.txt.
TRIVY_VERSION=v0.76.0
TRIVY_SHA256=e24b1c51293c1b15e4ba8d45bbc7891ba053f90278ec2698f3562c993e145fe7
