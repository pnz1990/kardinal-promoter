#
# Versions and sha256 sums of the binaries the e2e, pdca and demo-validate
# workflows download. Each workflow sources this file and checks every
# download with `sha256sum -c` before running it.
#
# To bump a tool, change its version and its sum together. Take the sum from
# the release's own checksum file, and check it against a hash of the
# downloaded binary:
#   kind:    https://github.com/kubernetes-sigs/kind/releases (kind-linux-amd64.sha256sum)
#   kubectl: https://dl.k8s.io/release/<version>/bin/linux/amd64/kubectl.sha256
#   argocd:  https://github.com/argoproj/argo-cd/releases (cli_checksums.txt)
#
# KUBECTL_VERSION keeps the minor of the kind node image in
# test/e2e/kind-config.yaml (kubectl supports one minor of skew, and
# test/hack checks they match).

KIND_VERSION=v0.29.0
KIND_SHA256=c72eda46430f065fb45c5f70e7c957cc9209402ef309294821978677c8fb3284

KUBECTL_VERSION=v1.33.13
KUBECTL_SHA256=316d712726d857c20744c57cb36aa47cfc79bc0af7e82cebf3780244b654c073

ARGOCD_VERSION=v2.10.3
ARGOCD_SHA256=031b3c72b9496cb6242abcf276855ece2fedb537e83db43c0ee3ada88a6f3803
