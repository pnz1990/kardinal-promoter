#
# Versions of the components the live e2e suites install (hack/e2e/up.sh).
# Each is the latest release when last bumped, so the suites test what users
# install today. Bump one at a time and run its suites.
#
# The kind, kubectl and helm binaries and the node images are pinned in
# hack/tool-versions.env and test/e2e/kind-config.yaml.

# Git servers
FORGEJO_IMAGE=codeberg.org/forgejo/forgejo:16.0.5-rootless
GITEA_IMAGE=docker.io/gitea/gitea:28.0.0-rootless
# 19.4.2 or later: older GitLab releases have a CVE (TestGitLabImageIsPatched).
GITLAB_IMAGE=docker.io/gitlab/gitlab-ce:19.4.2-ce.0

# GitOps engines and progressive delivery (release manifests)
ARGOCD_RELEASE=v3.5.3
FLUX_RELEASE=v2.9.5
ROLLOUTS_RELEASE=v1.10.0
FLAGGER_RELEASE=v1.45.0

# MetricCheck backend and the chart's ServiceMonitor/PrometheusRule
PROMETHEUS_OPERATOR_RELEASE=v0.94.1
PROMETHEUS_IMAGE=quay.io/prometheus/prometheus:v3.15.0
PUSHGATEWAY_IMAGE=quay.io/prometheus/pushgateway:v1.11.3

# Imports the chart's Grafana dashboard (grafana-community Helm chart; its
# appVersion pins the Grafana image)
GRAFANA_CHART_VERSION=13.2.7

# OCI registry for the Subscription tests (hack/e2e/components/registry.sh)
REGISTRY_IMAGE=docker.io/library/registry:3.1.2

# TLS certificates for the chart suite (release manifest)
CERT_MANAGER_RELEASE=v1.21.2

# The podinfo release the fixtures deploy first (test/e2e/fixtures V1) and the
# framework's probe Pods run; components/podinfo.sh pre-pulls it
PODINFO_IMAGE=ghcr.io/stefanprodan/podinfo:6.13.0

# OTLP receiver and query API for the chart suite's tracing test
# (hack/e2e/components/jaeger.sh)
JAEGER_IMAGE=docker.io/jaegertracing/jaeger:2.22.0

# The release the upgrade suite upgrades from (components/kardinal-v081.sh):
# its chart, the two images the chart runs, its CRDs (the chart ships none)
# and its CLI, checked with sha256sum -c.
V081_CHART=oci://ghcr.io/pnz1990/charts/kardinal-promoter
V081_CHART_VERSION=0.8.1
V081_CONTROLLER_IMAGE=ghcr.io/pnz1990/kardinal-promoter/controller:v0.8.1
V081_KROCODILE_IMAGE=ghcr.io/pnz1990/kardinal-promoter/krocodile:cdc4bb9
V081_CRD_BASE=https://raw.githubusercontent.com/pnz1990/kardinal-promoter/v0.8.1/config/crd/bases
V081_CLI_URL=https://github.com/pnz1990/kardinal-promoter/releases/download/v0.8.1/kardinal-linux-amd64
V081_CLI_SHA256=3751da0bd483879f3e4a346090f440649d04978695256576bca726b201466827

# The release the upgrade-v090 suite upgrades from
# (components/kardinal-v090.sh): its chart, which ships its CRDs, its
# controller image and its CLI, checked with sha256sum -c. Its kro is the
# version hack/install-kro.sh pinned at the v0.9.0 tag.
V090_CHART=oci://ghcr.io/pnz1990/charts/kardinal-promoter
V090_CHART_VERSION=0.9.0
V090_CONTROLLER_IMAGE=ghcr.io/pnz1990/kardinal-promoter/controller:v0.9.0
V090_KRO_VERSION=0.10.0-rc.0
V090_CLI_URL=https://github.com/pnz1990/kardinal-promoter/releases/download/v0.9.0/kardinal-linux-amd64
V090_CLI_SHA256=fecaa4c770fdad66049e5836e9e9e14bf4e1f09860b9c72ff192cfab11d84863

# The release the upgrade-v0100 suite upgrades from
# (components/kardinal-v0100.sh), pinned the same way: its chart, controller
# image and CLI (the sha256 is the release asset's digest), and the kro
# hack/install-kro.sh pinned at the v0.10.0 tag.
V0100_CHART=oci://ghcr.io/pnz1990/charts/kardinal-promoter
V0100_CHART_VERSION=0.10.0
V0100_CONTROLLER_IMAGE=ghcr.io/pnz1990/kardinal-promoter/controller:v0.10.0
V0100_KRO_VERSION=0.10.0-rc.0
V0100_CLI_URL=https://github.com/pnz1990/kardinal-promoter/releases/download/v0.10.0/kardinal-linux-amd64
V0100_CLI_SHA256=2b447602d35410273f9f522913e3fcc992c46ff01dd294e8da90e74aa8a66d8a

# The release the upgrade-v0110 suite upgrades from
# (components/kardinal-v0110.sh), pinned the same way.
V0110_CHART=oci://ghcr.io/pnz1990/charts/kardinal-promoter
V0110_CHART_VERSION=0.11.0
V0110_CONTROLLER_IMAGE=ghcr.io/pnz1990/kardinal-promoter/controller:v0.11.0
V0110_KRO_VERSION=0.10.0-rc.0
V0110_CLI_URL=https://github.com/pnz1990/kardinal-promoter/releases/download/v0.11.0/kardinal-linux-amd64
V0110_CLI_SHA256=948ffba8f46785af920fec6583e1fe897ac26f2c1543374e9bba8a116696950d

# The release the upgrade-v0120 suite upgrades from
# (components/kardinal-v0120.sh), pinned the same way.
V0120_CHART=oci://ghcr.io/pnz1990/charts/kardinal-promoter
V0120_CHART_VERSION=0.12.0
V0120_CONTROLLER_IMAGE=ghcr.io/pnz1990/kardinal-promoter/controller:v0.12.0
V0120_KRO_VERSION=0.10.0-rc.0
V0120_CLI_URL=https://github.com/pnz1990/kardinal-promoter/releases/download/v0.12.0/kardinal-linux-amd64
V0120_CLI_SHA256=6402a0d029e9a62c176a64163f49dd0755b03cef1feb51c043a7e51835211dfd

# Scale suite: the TCP proxy in front of the git server that injects latency
# and outages (hack/e2e/components/toxiproxy.sh), and the glibc runtime image
# of the -race controller build (KARDINAL_E2E_RACE=1 in components/kardinal.sh;
# a race build needs cgo and the alpine runtime has no glibc)
TOXIPROXY_IMAGE=ghcr.io/shopify/toxiproxy:2.12.0
RACE_RUNTIME_IMAGE=docker.io/library/debian:bookworm-slim

# Single sign-on for the sso suite (components/sso-pki.sh, components/sso.sh):
# the identity provider and the proxy of docs/guides/security.md, Option 3
DEX_IMAGE=ghcr.io/dexidp/dex:v2.46.0
OAUTH2_PROXY_IMAGE=quay.io/oauth2-proxy/oauth2-proxy:v7.15.5
# Dex's static ClusterIP (in kind's Service range 10.96.0.0/16), its issuer,
# the OAuth client both the API server and the proxy name, and the host name
# the browser uses for the UI
SSO_DEX_IP=10.96.100.100
SSO_ISSUER=https://10.96.100.100:5556/dex
SSO_CLIENT_ID=kardinal
SSO_HOST=kardinal.sso.test
