V0123_CLI_URL=https://github.com/pnz1990/kardinal-promoter/releases/download/v0.12.3/kardinal-linux-amd64
V0123_CLI_SHA256=197aa9e101fb3109222f2ad841daf8a4338495099122924becccc1a29dc10395

# Scale suite: the TCP proxy in front of the git server that injects latency
# and outages (hack/e2e/components/toxiproxy.sh), and the glibc runtime image
# of the -race controller build (KARDINAL_E2E_RACE=1 in components/kardinal.sh;
# a race build needs cgo and the alpine runtime has no glibc)
TOXIPROXY_IMAGE=ghcr.io/shopify/toxiproxy:2.12.0
RACE_RUNTIME_IMAGE=docker.io/library/debian:bookworm-slim

# Single sign-on for the sso suite (components/sso-pki.sh, components/sso.sh):
# the identity provider and the proxy of docs/guides/security.md, Option 3
DEX_IMAGE=ghcr.io/dexidp/dex:v2.46.0
OAUTH2_PROXY_IMAGE=quay.io/oauth2-proxy/oauth2-proxy:v7.15.5
# Dex's static ClusterIP (in kind's Service range 10.96.0.0/16), its issuer,
# the OAuth client both the API server and the proxy name, and the host name
# the browser uses for the UI
SSO_DEX_IP=10.96.100.100
SSO_ISSUER=https://10.96.100.100:5556/dex
SSO_CLIENT_ID=kardinal
SSO_HOST=kardinal.sso.test
# The receipts-keyless suite's sigstore stack (components/sigstore.sh):
# sigstore scaffolding's Fulcio, Rekor v2 (rekor-tiles), CT log, timestamp
# authority and TUF repository, which run as Knative Services (Serving and
# its Kourier ingress). Each manifest is checked with sha256sum -c; the
# images in them are pinned by digest.
KNATIVE_RELEASE=knative-v1.19.0
KNATIVE_SERVING_CRDS_SHA256=9a94d5b2233d2b0af44fecce1b73262318f4af25e9e378906b3d998887f18be7
KNATIVE_SERVING_CORE_SHA256=514b0f27efa8ce0f445a69837cf4c759a60e8fbbd23ac62f7689792507ffbe1b
KNATIVE_KOURIER_SHA256=7615a1dc3d8bcaf1017c5a08d7f602c7f8072c9a287df21bb45ed329232e5c2e
SIGSTORE_SCAFFOLDING_RELEASE=v0.7.39
SIGSTORE_FULCIO_SHA256=d75415104779d30374fe2579ae0c7f5f8d53565969bdfaa3619d229de0c24639
SIGSTORE_REKOR_TILES_SHA256=bb92109b978663962a62e52ec17e3c4e9e642f183dc10d5b1fac9ea6e3f3ff5e
SIGSTORE_CTLOG_SHA256=86a8a231d607441de873aeaaf7582642094395d471c05e53f1ca46facc9ba6c4
SIGSTORE_TSA_SHA256=732a7520d7bdb2398a9c24cacd102e72b4e552a83618327581d854e86add7b65
SIGSTORE_TUF_SHA256=074877766a1b7769ab0b6a8b83e08e8d999ac1b6fe9067e2e25b761a6821f1a3
# Reads the trusted root from the TUF repository inside the cluster.
CURL_IMAGE=docker.io/curlimages/curl:8.11.1
