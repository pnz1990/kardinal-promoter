V0100_CLI_SHA256=2b447602d35410273f9f522913e3fcc992c46ff01dd294e8da90e74aa8a66d8a

# The release the upgrade-v0110 suite upgrades from
# (components/kardinal-v0110.sh), pinned the same way.
V0110_CHART=oci://ghcr.io/pnz1990/charts/kardinal-promoter
V0110_CHART_VERSION=0.11.0
V0110_CHART_DIGEST=sha256:7d622aeaacd317b34295e941485a467cf0f119437ca8fb86a4cc6dd70162a37d
V0110_CONTROLLER_IMAGE=ghcr.io/pnz1990/kardinal-promoter/controller:v0.11.0
