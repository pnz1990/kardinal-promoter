# The release the upgrade-v0123 suite upgrades from
# (components/kardinal-v0123.sh), pinned the same way: the image index
# digest from the registry, the CLI's sha256 from the release asset.
V0123_CHART=oci://ghcr.io/pnz1990/charts/kardinal-promoter
V0123_CHART_VERSION=0.12.3
V0123_CHART_DIGEST=sha256:866c9efa35914e17cadb70a3d305005b159ffaec5fb6f26aee18bcc58ac91648
V0123_CONTROLLER_IMAGE=ghcr.io/pnz1990/kardinal-promoter/controller:v0.12.3
V0123_CONTROLLER_DIGEST=sha256:8ec708d088ecda7ed2677f2271d1f1507e339790c711749d4ee42212fe1ce3ed
