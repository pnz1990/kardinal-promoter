# The release the upgrade-v0121 suite upgrades from
# (components/kardinal-v0121.sh), pinned the same way: the image index
# digest from the registry, the CLI's sha256 from the release asset.
V0121_CHART=oci://ghcr.io/pnz1990/charts/kardinal-promoter
V0121_CHART_VERSION=0.12.1
V0121_CHART_DIGEST=sha256:de08f87bceea45360bdb081a43bac8abb57f72076c27a09531ce45a85a0067e7
V0121_CONTROLLER_IMAGE=ghcr.io/pnz1990/kardinal-promoter/controller:v0.12.1
V0121_CONTROLLER_DIGEST=sha256:b312f089899bda94c2459ef30498b0539a13022f1b0c4046663c38a432328f55
V0121_KRO_VERSION=0.10.0-rc.0
V0121_CLI_URL=https://github.com/pnz1990/kardinal-promoter/releases/download/v0.12.1/kardinal-linux-amd64
