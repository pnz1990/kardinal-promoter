{
  "name": "kardinal-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "tokens": "node ../scripts/gen-tokens.mjs",
    "tokens:check": "node ../scripts/gen-tokens.mjs --check",
    "size": "node scripts/check-size.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --grep-invert @perf && playwright test --grep @perf --workers=1",
    "test:e2e:server": "node test/e2e/mock-server/server.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@tanstack/react-virtual": "^3.14.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.2",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
