{
  "$description": "kardinal design tokens (Thread). The only file a person edits: run `make tokens` (node scripts/gen-tokens.mjs) to regenerate web/src/styles/tokens.css, web/src/tokens.ts and docs/stylesheets/tokens.css. Leaf tokens are {\"$value\", \"$type\"}; a themed value is {\"light\", \"dark\"}; \"{a.b}\" refers to another token. $extensions.kardinal.contrast lists the WCAG 2.1 minimums contrast.test.ts checks in both themes.",
  "color": {
    "brand": {
      "cardinal": { "$type": "color", "$value": "#EC1F24", "$description": "Sampled from the logo. The logo and the light theme's thread stroke; never behind text." },
      "charcoal": { "$type": "color", "$value": "#555555", "$description": "Sampled from the logo's dark nodes." }
    },
    "surface": {
      "sunken": { "$type": "color", "$value": { "light": "#E6EAE8", "dark": "#0A0F0D" }, "$description": "Wells, code blocks, matrix gutters." },
      "canvas": { "$type": "color", "$value": { "light": "#F2F4F3", "dark": "#0F1513" }, "$description": "App and docs background: Frost / Spruce night." },
      "base": { "$type": "color", "$value": { "light": "#FAFBFA", "dark": "#151D1A" }, "$description": "Panels, tables, the map plane." },
      "raised": { "$type": "color", "$value": { "light": "#FFFFFF", "dark": "#1C2622" }, "$description": "Drawer, popovers, dialogs; always with a border and a shadow." }
    },
    "line": {
      "subtle": { "$type": "color", "$value": { "light": "#DCE2DF", "dark": "#222D29" }, "$description": "Row dividers." },
      "DEFAULT": { "$type": "color", "$value": { "light": "#C7D0CC", "dark": "#2B3733" }, "$description": "Panel borders, inactive edges." },
      "strong": {
        "$type": "color", "$value": { "light": "#76837E", "dark": "#66796F" }, "$description": "Pending ring, input borders (non-text).",
        "$extensions": { "kardinal": { "contrast": [ { "on": "color.surface.sunken", "min": 3 }, { "on": "color.surface.raised", "min": 3 }, { "on": "color.surface.base", "min": 3 } ] } }
      }
    },
    "ink": {
      "DEFAULT": {
        "$type": "color", "$value": { "light": "#18211E", "dark": "#E3EAE6" }, "$description": "Text.",
        "$extensions": { "kardinal": { "contrast": [ { "on": "color.surface.canvas", "min": 7 }, { "on": "color.surface.base", "min": 7 }, { "on": "color.surface.raised", "min": 7 }, { "on": "color.surface.sunken", "min": 7 } ] } }
      },
      "2": {
        "$type": "color", "$value": { "light": "#4A5651", "dark": "#A6B2AD" }, "$description": "Secondary text.",
        "$extensions": { "kardinal": { "contrast": [ { "on": "color.surface.canvas", "min": 4.5 }, { "on": "color.surface.base", "min": 4.5 }, { "on": "color.surface.raised", "min": 4.5 }, { "on": "color.surface.sunken", "min": 4.5 } ] } }
      },
      "3": {
        "$type": "color", "$value": { "light": "#5F6B66", "dark": "#8C9994" }, "$description": "Captions, timestamps.",
        "$extensions": { "kardinal": { "contrast": [ { "on": "color.surface.canvas", "min": 4.5 }, { "on": "color.surface.base", "min": 4.5 }, { "on": "color.surface.raised", "min": 4.5 }, { "on": "color.surface.sunken", "min": 4.5 } ] } }
      },
      "node": {
        "$type": "color", "$value": { "light": "#555555", "dark": "#9AA39F" }, "$description": "Inked (Verified) station fill, structural edges.",
        "$extensions": { "kardinal": { "contrast": [ { "on": "color.surface.canvas", "min": 3 }, { "on": "color.surface.base", "min": 3 } ] } }
      },
      "inverse": { "$type": "color", "$value": { "light": "#FAFBFA", "dark": "#0F1513" }, "$description": "Text on filled chips." }
    },
    "thread": {
      "DEFAULT": {
        "$type": "color", "$value": { "light": "#EC1F24", "dark": "#FF4D52" }, "$description": "The followed bundle's route, selection halo, focus ring. The only red in the interface; a stroke, never a fill behind text.",
        "$extensions": { "kardinal": { "contrast": [ { "on": "color.surface.canvas", "min": 3 }, { "on": "color.surface.base", "min": 3 }, { "on": "color.surface.raised", "min": 3 } ] } }
      },
      "text": {
        "$type": "color", "$value": { "light": "#C0151B", "dark": "#FF7A7E" }, "$description": "Red text: the Promoting label, link underlines.",
        "$extensions": { "kardinal": { "contrast": [ { "on": "color.surface.canvas", "min": 4.5 }, { "on": "color.surface.base", "min": 4.5 }, { "on": "color.surface.raised", "min": 4.5 }, { "on": "color.thread.wash", "min": 4.5 } ] } }
      },
      "wash": { "$type": "color", "$value": { "light": "#FBE6E5", "dark": "#3A1717" }, "$description": "Promoting chip background." },
      "ghost": { "$type": "color", "$value": "color-mix(in oklab, {color.thread.DEFAULT} 35%, transparent)", "$description": "Hover preview of another bundle's route." }
    },
    "status": {
      "verified": {
        "fg": {
          "$type": "color", "$value": { "light": "#2B6E52", "dark": "#6CC79B" }, "$description": "Verified, Pass, Ready (spruce).",
          "$extensions": { "kardinal": { "contrast": [ { "on": "color.surface.canvas", "min": 4.5 }, { "on": "color.surface.base", "min": 4.5 }, { "on": "color.surface.raised", "min": 4.5 }, { "on": "color.status.verified.wash", "min": 4.5 } ] } }
        },
        "wash": { "$type": "color", "$value": { "light": "#E3F0E9", "dark": "#173126" } }
      },
      "promoting": {
        "fg": { "$type": "color", "$value": "{color.thread.text}", "$description": "Promoting, WaitingForMerge, HealthChecking, Verifying." },
        "wash": { "$type": "color", "$value": "{color.thread.wash}" }
      },
      "waiting": {
        "fg": {
          "$type": "color", "$value": { "light": "#35609E", "dark": "#8FB2EC" }, "$description": "Gate Waiting/Pending, approval awaiting quorum, PR open, bake in progress (dusk).",
          "$extensions": { "kardinal": { "contrast": [ { "on": "color.surface.canvas", "min": 4.5 }, { "on": "color.surface.base", "min": 4.5 }, { "on": "color.surface.raised", "min": 4.5 }, { "on": "color.status.waiting.wash", "min": 4.5 } ] } }
        },
        "wash": { "$type": "color", "$value": { "light": "#E4ECF7", "dark": "#1A2740" } }
      },
      "blocked": {
        "fg": {
          "$type": "color", "$value": { "light": "#865400", "dark": "#EDB15A" }, "$description": "Gate Block (holding), ChangeWindow active (ochre).",
          "$extensions": { "kardinal": { "contrast": [ { "on": "color.surface.canvas", "min": 4.5 }, { "on": "color.surface.base", "min": 4.5 }, { "on": "color.surface.raised", "min": 4.5 }, { "on": "color.status.blocked.wash", "min": 4.5 } ] } }
        },
        "wash": { "$type": "color", "$value": { "light": "#F7EBD6", "dark": "#33260F" } }
      },
      "failed": {
        "fg": {
          "$type": "color", "$value": { "light": "#8A1E66", "dark": "#E78DD4" }, "$description": "Failed, AbortedByAlarm, RollingBack, a live Rejected bundle, a rejected approval (garnet: a plum-wine, kept at least 40° of hue from the cardinal thread; contrast.test.ts checks it).",
          "$extensions": { "kardinal": { "contrast": [ { "on": "color.surface.canvas", "min": 4.5 }, { "on": "color.surface.base", "min": 4.5 }, { "on": "color.surface.raised", "min": 4.5 }, { "on": "color.status.failed.wash", "min": 4.5 } ] } }
        },
        "fill": { "$type": "color", "$value": { "light": "#8A1E66", "dark": "#E78DD4" }, "$description": "The only filled status chip." },
        "on-fill": {
          "$type": "color", "$value": { "light": "{color.ink.inverse}", "dark": "#0F1513" },
          "$extensions": { "kardinal": { "contrast": [ { "on": "color.status.failed.fill", "min": 4.5 } ] } }
        },
        "wash": { "$type": "color", "$value": { "light": "#FCE8F2", "dark": "#381F33" }, "$description": "Background for garnet text where a filled chip is too loud (banners, inline errors)." }
      },
      "superseded": { "fg": { "$type": "color", "$value": "{color.ink.3}" } },
      "paused": { "fg": { "$type": "color", "$value": "{color.ink.DEFAULT}" } },
      "held": { "fg": { "$type": "color", "$value": "{color.ink.DEFAULT}" } },
      "pending": { "ring": { "$type": "color", "$value": "{color.line.strong}" } }
    },
    "syntax": {
      "keyword": { "$type": "color", "$value": "{color.ink.DEFAULT}", "$description": "Set at weight 600." },
      "ident": {
        "$type": "color", "$value": { "light": "#35609E", "dark": "#8FB2EC" },
        "$extensions": { "kardinal": { "contrast": [ { "on": "color.surface.sunken", "min": 4.5 }, { "on": "color.surface.base", "min": 4.5 } ] } }
      },
      "string": {
        "$type": "color", "$value": { "light": "#2B6E52", "dark": "#6CC79B" },
        "$extensions": { "kardinal": { "contrast": [ { "on": "color.surface.sunken", "min": 4.5 }, { "on": "color.surface.base", "min": 4.5 } ] } }
      },
      "number": {
        "$type": "color", "$value": { "light": "#865400", "dark": "#EDB15A" },
        "$extensions": { "kardinal": { "contrast": [ { "on": "color.surface.sunken", "min": 4.5 }, { "on": "color.surface.base", "min": 4.5 } ] } }
      },
      "function": {
        "$type": "color", "$value": { "light": "#C0151B", "dark": "#FF7A7E" },
        "$extensions": { "kardinal": { "contrast": [ { "on": "color.surface.sunken", "min": 4.5 }, { "on": "color.surface.base", "min": 4.5 } ] } }
      },
      "comment": { "$type": "color", "$value": "{color.ink.3}", "$description": "Set in italics." },
      "punct": { "$type": "color", "$value": "{color.ink.2}" }
    }
  },
  "shadow": {
    "color": { "$type": "hsl-channels", "$value": { "light": "165 20% 8%", "dark": "165 30% 2%" }, "$description": "HSL channels for the elevation shadows." }
  },
  "font": {
    "display": { "$type": "fontFamily", "$value": "\"Archivo\", \"Archivo Fallback\", system-ui, -apple-system, \"Segoe UI\", sans-serif", "$description": "Headings, page titles, station labels, tags, tab labels." },
    "body": { "$type": "fontFamily", "$value": "\"Atkinson Hyperlegible Next\", \"Atkinson Hyperlegible Next Fallback\", system-ui, -apple-system, \"Segoe UI\", sans-serif", "$description": "Running text, buttons, form fields." },
    "mono": { "$type": "fontFamily", "$value": "\"Atkinson Hyperlegible Mono\", \"Atkinson Hyperlegible Mono Fallback\", ui-monospace, \"SFMono-Regular\", Menlo, Consolas, monospace", "$description": "Versions, SHAs, image refs, CEL, YAML, CLI, code." }
  },
  "text": {
    "2xs": { "$type": "dimension", "$value": "0.6875rem", "$description": "Eyebrows, wave labels, tags: Archivo, label width, 600, caps, letter-spacing .06em." },
    "xs": { "$type": "dimension", "$value": "0.75rem" },
    "sm": { "$type": "dimension", "$value": "0.8125rem" },
    "md": { "$type": "dimension", "$value": "0.875rem", "$description": "UI default." },
    "lg": { "$type": "dimension", "$value": "1rem", "$description": "Docs body, drawer lead." },
    "xl": { "$type": "dimension", "$value": "1.1875rem" },
    "2xl": { "$type": "dimension", "$value": "1.4375rem" },
    "3xl": { "$type": "dimension", "$value": "1.75rem" },
    "display": { "$type": "dimension", "$value": "clamp(2.25rem, 1.4rem + 3.2vw, 4rem)", "$description": "Docs hero only." }
  },
  "leading": {
    "2xs": { "$type": "number", "$value": 1.3, "$extensions": { "kardinal": { "css": true } } },
    "xs": { "$type": "number", "$value": 1.35, "$extensions": { "kardinal": { "css": true } } },
    "sm": { "$type": "number", "$value": 1.4, "$extensions": { "kardinal": { "css": true } } },
    "md": { "$type": "number", "$value": 1.45, "$extensions": { "kardinal": { "css": true } } },
    "lg": { "$type": "number", "$value": 1.55, "$extensions": { "kardinal": { "css": true } } },
    "xl": { "$type": "number", "$value": 1.3, "$extensions": { "kardinal": { "css": true } } },
    "2xl": { "$type": "number", "$value": 1.2, "$extensions": { "kardinal": { "css": true } } },
    "3xl": { "$type": "number", "$value": 1.15, "$extensions": { "kardinal": { "css": true } } },
    "display": { "$type": "number", "$value": 1, "$extensions": { "kardinal": { "css": true } } }
  },
  "tracking": {
    "caps": { "$type": "dimension", "$value": "0.06em" },
    "display": { "$type": "dimension", "$value": "-0.02em" }
  },
  "stretch": {
    "dense": { "$type": "fontStretch", "$value": "75%" },
    "label": { "$type": "fontStretch", "$value": "87.5%" },
    "normal": { "$type": "fontStretch", "$value": "100%" },
    "title": { "$type": "fontStretch", "$value": "112.5%" },
    "display": { "$type": "fontStretch", "$value": "118%" }
  },
  "weight": {
    "regular": { "$type": "fontWeight", "$value": 400 },
    "medium": { "$type": "fontWeight", "$value": 500 },
    "semibold": { "$type": "fontWeight", "$value": 600 },
    "section": { "$type": "fontWeight", "$value": 650 },
    "bold": { "$type": "fontWeight", "$value": 700 },
    "title": { "$type": "fontWeight", "$value": 750 },
    "display": { "$type": "fontWeight", "$value": 800 }
  },
  "numeric": {
    "DEFAULT": { "$type": "fontVariantNumeric", "$value": "tabular-nums", "$description": "Every count, age and duration." },
    "mono": { "$type": "fontVariantNumeric", "$value": "tabular-nums slashed-zero" }
  },
  "space": {
    "0": { "$type": "space", "$value": 0 },
    "px": { "$type": "dimension", "$value": "1px", "$description": "Never scaled by density." },
    "0_5": { "$type": "space", "$value": 0.5 },
    "1": { "$type": "space", "$value": 1 },
    "1_5": { "$type": "space", "$value": 1.5 },
    "2": { "$type": "space", "$value": 2 },
    "3": { "$type": "space", "$value": 3 },
    "4": { "$type": "space", "$value": 4 },
    "6": { "$type": "space", "$value": 6 },
    "8": { "$type": "space", "$value": 8 },
    "12": { "$type": "space", "$value": 12 },
    "16": { "$type": "space", "$value": 16 },
    "24": { "$type": "space", "$value": 24 }
  },
  "density": {
    "comfortable": { "$type": "number", "$value": 1 },
    "compact": { "$type": "number", "$value": 0.75 }
  },
  "control": {
    "sm": { "$type": "dimension", "$value": "1.75rem" },
    "md": { "$type": "dimension", "$value": "2.25rem" },
    "lg": { "$type": "dimension", "$value": "2.75rem", "$description": "Also sm and md on coarse pointers (touch targets of 44px)." }
  },
  "radius": {
    "0": { "$type": "dimension", "$value": "0" },
    "1": { "$type": "dimension", "$value": "2px", "$description": "Chips, tags." },
    "2": { "$type": "dimension", "$value": "4px", "$description": "Buttons, inputs." },
    "3": { "$type": "dimension", "$value": "6px", "$description": "Panels, drawer, dialogs, code blocks." },
    "dot": { "$type": "dimension", "$value": "50%" },
    "pill": { "$type": "dimension", "$value": "999px", "$description": "Count badges only." }
  },
  "border": {
    "hairline": { "$type": "dimension", "$value": "1px" },
    "strong": { "$type": "dimension", "$value": "1.5px" }
  },
  "stroke": {
    "edge": { "$type": "dimension", "$value": "1.25px" },
    "thread": { "$type": "dimension", "$value": "2.5px" },
    "thread-focus": { "$type": "dimension", "$value": "3.5px" },
    "ring": { "$type": "dimension", "$value": "2px" }
  },
  "focus": {
    "ring": { "$type": "border", "$value": "2px solid {color.thread.DEFAULT}" },
    "offset": { "$type": "dimension", "$value": "2px" }
  },
  "elev": {
    "0": { "$type": "shadow", "$value": "none" },
    "1": { "$type": "shadow", "$value": "0 1px 2px hsl({shadow.color} / .10)", "$description": "Popover, tooltip." },
    "2": { "$type": "shadow", "$value": "0 6px 16px -4px hsl({shadow.color} / .18), 0 1px 0 hsl({shadow.color} / .06)", "$description": "Drawer, palette." },
    "3": { "$type": "shadow", "$value": "0 18px 40px -8px hsl({shadow.color} / .28)", "$description": "Dialog." }
  },
  "dur": {
    "instant": { "$type": "duration", "$value": "80ms", "$description": "Opacity only; kept when motion is reduced." },
    "quick": { "$type": "duration", "$value": "140ms", "$description": "Hover, chip state." },
    "base": { "$type": "duration", "$value": "220ms", "$description": "Drawer, panel." },
    "slow": { "$type": "duration", "$value": "360ms", "$description": "Change halo." },
    "thread": { "$type": "duration", "$value": "640ms", "$description": "The thread advancing one edge." },
    "pulse": { "$type": "duration", "$value": "1800ms", "$description": "Promoting tip, one loop." }
  },
  "ease": {
    "out": { "$type": "cubicBezier", "$value": "cubic-bezier(.2, .8, .2, 1)" },
    "in-out": { "$type": "cubicBezier", "$value": "cubic-bezier(.6, 0, .2, 1)" },
    "flight": { "$type": "cubicBezier", "$value": "cubic-bezier(.3, 0, .1, 1)", "$description": "The thread." }
  },
  "z": {
    "base": { "$type": "number", "$value": 0, "$extensions": { "kardinal": { "css": true } } },
    "map-overlay": { "$type": "number", "$value": 10, "$extensions": { "kardinal": { "css": true } } },
    "sticky": { "$type": "number", "$value": 20, "$extensions": { "kardinal": { "css": true } } },
    "rail": { "$type": "number", "$value": 30, "$extensions": { "kardinal": { "css": true } } },
    "drawer": { "$type": "number", "$value": 40, "$extensions": { "kardinal": { "css": true } } },
    "popover": { "$type": "number", "$value": 50, "$extensions": { "kardinal": { "css": true } } },
    "palette": { "$type": "number", "$value": 60, "$extensions": { "kardinal": { "css": true } } },
    "dialog": { "$type": "number", "$value": 70, "$extensions": { "kardinal": { "css": true } } },
    "toast": { "$type": "number", "$value": 80, "$extensions": { "kardinal": { "css": true } } },
    "skip": { "$type": "number", "$value": 90, "$extensions": { "kardinal": { "css": true } } }
  },
  "breakpoint": {
    "sm": { "$type": "number", "$value": 640, "$description": "px; custom properties cannot drive @media, so these are tokens.ts constants." },
    "md": { "$type": "number", "$value": 960 },
    "lg": { "$type": "number", "$value": 1280 },
    "xl": { "$type": "number", "$value": 1680 }
  },
  "container": {
    "narrow": { "$type": "number", "$value": 480, "$description": "px; the only px values hand-written CSS may use, inside an @container prelude." },
    "medium": { "$type": "number", "$value": 720 },
    "wide": { "$type": "number", "$value": 1024 }
  },
  "graph": {
    "station": {
      "r": { "$type": "dimension", "$value": "6px" },
      "rFocus": { "$type": "dimension", "$value": "9px" }
    },
    "labelGap": { "$type": "dimension", "$value": "8px" },
    "rankSep": { "$type": "dimension", "$value": "72px" },
    "nodeSep": { "$type": "dimension", "$value": "28px" },
    "chamfer": { "$type": "dimension", "$value": "12px", "$description": "The 45° bend leg." },
    "gateTick": { "$type": "dimension", "$value": "10px" },
    "waveCollapseAt": { "$type": "number", "$value": 5, "$description": "Same-depth environments that collapse into a band." },
    "overviewAt": { "$type": "number", "$value": 40, "$description": "Environments above which the map opens in Overview." },
    "grid": {
      "cell": { "$type": "dimension", "$value": "10px" },
      "gap": { "$type": "dimension", "$value": "2px" }
    },
    "zoom": {
      "min": { "$type": "number", "$value": 0.2 },
      "overview": { "$type": "number", "$value": 0.55 },
      "detail": { "$type": "number", "$value": 1 },
      "max": { "$type": "number", "$value": 2.5 }
    }
  },
  "poll": {
    "intervalMs": { "$type": "number", "$value": 5000 },
    "staleAfterS": { "$type": "number", "$value": 30 }
  },
  "layout": {
    "rail": {
      "collapsed": { "$type": "dimension", "$value": "3.5rem" },
      "expanded": { "$type": "dimension", "$value": "15rem" }
    },
    "drawer": { "$type": "dimension", "$value": "min(32rem, 92vw)" },
    "dialog": { "$type": "dimension", "$value": "min(28rem, 100%)", "$description": "Dialogs." },
    "measure": { "$type": "dimension", "$value": "72ch" }
  }
}
